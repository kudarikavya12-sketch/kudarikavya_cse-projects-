/*
 * ============================================================
 * MINI UNIX SHELL
 * ============================================================
 *
 * Features:
 *   1. Command execution using fork() + execvp()
 *   2. Process synchronization using waitpid()
 *   3. Background execution using &
 *   4. Signal handling (SIGINT / SIGCHLD)
 *   5. Input/output/error redirection
 *      < input.txt
 *      > output.txt
 *      >> output.txt
 *      2> error.txt
 *   6. Pipes
 *      ls | grep txt | wc -l
 *   7. Built-in commands:
 *      cd
 *      pwd
 *      exit
 *      help
 *
 * ============================================================
 */

#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <sys/types.h>
#include <sys/wait.h>
#include <sys/stat.h>
#include <fcntl.h>
#include <signal.h>
#include <errno.h>


#define MAX_INPUT 4096
#define MAX_ARGS 128
#define MAX_COMMANDS 16


/* ============================================================
   GLOBAL VARIABLES
   ============================================================ */

volatile sig_atomic_t child_finished = 0;


/* ============================================================
   SIGNAL HANDLER
   ============================================================ */

void handle_sigchld(int sig)
{
    (void)sig;

    child_finished = 1;
}


/* ============================================================
   REAP BACKGROUND PROCESSES
   ============================================================ */

void reap_background_processes()
{
    int status;

    while (waitpid(-1, &status, WNOHANG) > 0)
    {
        printf("\n[Background process completed]\n");
        fflush(stdout);
    }

    child_finished = 0;
}


/* ============================================================
   DISPLAY PROMPT
   ============================================================ */

void display_prompt()
{
    char cwd[1024];

    if (getcwd(cwd, sizeof(cwd)) != NULL)
    {
        printf("\033[1;32mmini-shell\033[0m:");
        printf("\033[1;34m%s\033[0m$ ", cwd);
    }
    else
    {
        printf("mini-shell$ ");
    }

    fflush(stdout);
}


/* ============================================================
   REMOVE NEWLINE
   ============================================================ */

void remove_newline(char *str)
{
    size_t len = strlen(str);

    if (len > 0 && str[len - 1] == '\n')
    {
        str[len - 1] = '\0';
    }
}


/* ============================================================
   TOKENIZE COMMAND
   ============================================================ */

int tokenize(char *input, char **tokens)
{
    int count = 0;

    char *token = strtok(
        input,
        " \t"
    );

    while (token != NULL && count < MAX_ARGS - 1)
    {
        tokens[count++] = token;

        token = strtok(
            NULL,
            " \t"
        );
    }

    tokens[count] = NULL;

    return count;
}


/* ============================================================
   APPLY REDIRECTION
   ============================================================ */

void handle_redirection(
    char **args,
    int *argc
)
{
    int i = 0;

    while (i < *argc)
    {
        /*
         * Input redirection
         *
         * command < file
         */

        if (strcmp(args[i], "<") == 0)
        {
            if (i + 1 >= *argc)
            {
                fprintf(
                    stderr,
                    "mini-shell: missing input file\n"
                );

                exit(EXIT_FAILURE);
            }

            int fd = open(
                args[i + 1],
                O_RDONLY
            );

            if (fd < 0)
            {
                perror("open");
                exit(EXIT_FAILURE);
            }

            if (dup2(fd, STDIN_FILENO) < 0)
            {
                perror("dup2");
                close(fd);
                exit(EXIT_FAILURE);
            }

            close(fd);

            /*
             * Remove < and filename
             */

            for (int j = i; j + 2 <= *argc; j++)
            {
                args[j] = args[j + 2];
            }

            *argc -= 2;

            continue;
        }


        /*
         * Output redirection
         *
         * command > file
         */

        if (strcmp(args[i], ">") == 0)
        {
            if (i + 1 >= *argc)
            {
                fprintf(
                    stderr,
                    "mini-shell: missing output file\n"
                );

                exit(EXIT_FAILURE);
            }

            int fd = open(
                args[i + 1],
                O_WRONLY |
                O_CREAT |
                O_TRUNC,
                0644
            );

            if (fd < 0)
            {
                perror("open");
                exit(EXIT_FAILURE);
            }

            if (dup2(fd, STDOUT_FILENO) < 0)
            {
                perror("dup2");
                close(fd);
                exit(EXIT_FAILURE);
            }

            close(fd);

            for (int j = i; j + 2 <= *argc; j++)
            {
                args[j] = args[j + 2];
            }

            *argc -= 2;

            continue;
        }


        /*
         * Append redirection
         *
         * command >> file
         */

        if (strcmp(args[i], ">>") == 0)
        {
            if (i + 1 >= *argc)
            {
                fprintf(
                    stderr,
                    "mini-shell: missing output file\n"
                );

                exit(EXIT_FAILURE);
            }

            int fd = open(
                args[i + 1],
                O_WRONLY |
                O_CREAT |
                O_APPEND,
                0644
            );

            if (fd < 0)
            {
                perror("open");
                exit(EXIT_FAILURE);
            }

            if (dup2(fd, STDOUT_FILENO) < 0)
            {
                perror("dup2");
                close(fd);
                exit(EXIT_FAILURE);
            }

            close(fd);

            for (int j = i; j + 2 <= *argc; j++)
            {
                args[j] = args[j + 2];
            }

            *argc -= 2;

            continue;
        }


        /*
         * Error redirection
         *
         * command 2> error.txt
         */

        if (strcmp(args[i], "2>") == 0)
        {
            if (i + 1 >= *argc)
            {
                fprintf(
                    stderr,
                    "mini-shell: missing error file\n"
                );

                exit(EXIT_FAILURE);
            }

            int fd = open(
                args[i + 1],
                O_WRONLY |
                O_CREAT |
                O_TRUNC,
                0644
            );

            if (fd < 0)
            {
                perror("open");
                exit(EXIT_FAILURE);
            }

            if (dup2(fd, STDERR_FILENO) < 0)
            {
                perror("dup2");
                close(fd);
                exit(EXIT_FAILURE);
            }

            close(fd);

            for (int j = i; j + 2 <= *argc; j++)
            {
                args[j] = args[j + 2];
            }

            *argc -= 2;

            continue;
        }

        i++;
    }

    args[*argc] = NULL;
}


/* ============================================================
   CHECK BUILT-IN COMMAND
   ============================================================ */

int handle_builtin(
    char **args,
    int argc
)
{
    if (argc == 0)
    {
        return 1;
    }


    /* --------------------------------------------------------
       EXIT
       -------------------------------------------------------- */

    if (strcmp(args[0], "exit") == 0)
    {
        printf("Exiting mini-shell...\n");

        exit(0);
    }


    /* --------------------------------------------------------
       HELP
       -------------------------------------------------------- */

    if (strcmp(args[0], "help") == 0)
    {
        printf("\n");
        printf("Mini UNIX Shell Commands\n");
        printf("-------------------------\n");
        printf("cd <directory>    Change directory\n");
        printf("pwd               Show current directory\n");
        printf("help              Show this help message\n");
        printf("exit              Exit shell\n");
        printf("\n");

        printf("Supported features:\n");
        printf("  Background: command &\n");
        printf("  Input:      command < file\n");
        printf("  Output:     command > file\n");
        printf("  Append:     command >> file\n");
        printf("  Error:      command 2> file\n");
        printf("  Pipes:      command1 | command2\n");
        printf("\n");

        return 1;
    }


    /* --------------------------------------------------------
       CD
       -------------------------------------------------------- */

    if (strcmp(args[0], "cd") == 0)
    {
        if (argc < 2)
        {
            fprintf(
                stderr,
                "mini-shell: cd: missing directory\n"
            );

            return 1;
        }

        if (chdir(args[1]) != 0)
        {
            perror("cd");
        }

        return 1;
    }


    /* --------------------------------------------------------
       PWD
       -------------------------------------------------------- */

    if (strcmp(args[0], "pwd") == 0)
    {
        char cwd[1024];

        if (getcwd(cwd, sizeof(cwd)) != NULL)
        {
            printf("%s\n", cwd);
        }
        else
        {
            perror("pwd");
        }

        return 1;
    }


    return 0;
}


/* ============================================================
   EXECUTE SINGLE COMMAND
   ============================================================ */

void execute_command(
    char **args,
    int argc,
    int background
)
{
    pid_t pid = fork();


    /* --------------------------------------------------------
       FORK ERROR
       -------------------------------------------------------- */

    if (pid < 0)
    {
        perror("fork");
        return;
    }


    /* --------------------------------------------------------
       CHILD PROCESS
       -------------------------------------------------------- */

    if (pid == 0)
    {
        /*
         * Restore default SIGINT behavior.
         */

        signal(
            SIGINT,
            SIG_DFL
        );


        /*
         * Handle redirection.
         */

        handle_redirection(
            args,
            &argc
        );


        /*
         * Execute program.
         */

        execvp(
            args[0],
            args
        );


        /*
         * execvp only returns if
         * execution failed.
         */

        perror("execvp");

        exit(EXIT_FAILURE);
    }


    /* --------------------------------------------------------
       PARENT PROCESS
       -------------------------------------------------------- */

    if (background)
    {
        printf(
            "[Background process started: PID %d]\n",
            pid
        );
    }
    else
    {
        /*
         * Wait for foreground process.
         */

        int status;

        if (waitpid(
                pid,
                &status,
                0
            ) < 0)
        {
            perror("waitpid");
        }
    }
}


/* ============================================================
   SPLIT COMMAND INTO PIPE SEGMENTS
   ============================================================ */

int split_pipes(
    char *input,
    char **commands
)
{
    int count = 0;

    char *command = strtok(
        input,
        "|"
    );

    while (
        command != NULL &&
        count < MAX_COMMANDS
    )
    {
        commands[count++] = command;

        command = strtok(
            NULL,
            "|"
        );
    }

    return count;
}


/* ============================================================
   EXECUTE PIPELINE
   ============================================================ */

void execute_pipeline(
    char **commands,
    int command_count,
    int background
)
{
    int pipes[MAX_COMMANDS - 1][2];

    pid_t pids[MAX_COMMANDS];


    /*
     * Create pipes.
     */

    for (int i = 0; i < command_count - 1; i++)
    {
        if (pipe(pipes[i]) < 0)
        {
            perror("pipe");
            return;
        }
    }


    /*
     * Create processes.
     */

    for (int i = 0; i < command_count; i++)
    {
        pids[i] = fork();


        if (pids[i] < 0)
        {
            perror("fork");
            return;
        }


        /* ----------------------------------------------------
           CHILD
           ---------------------------------------------------- */

        if (pids[i] == 0)
        {
            /*
             * Restore normal SIGINT handling.
             */

            signal(
                SIGINT,
                SIG_DFL
            );


            /*
             * If not first command,
             * read from previous pipe.
             */

            if (i > 0)
            {
                if (dup2(
                        pipes[i - 1][0],
                        STDIN_FILENO
                    ) < 0)
                {
                    perror("dup2");
                    exit(EXIT_FAILURE);
                }
            }


            /*
             * If not last command,
             * write to next pipe.
             */

            if (i < command_count - 1)
            {
                if (dup2(
                        pipes[i][1],
                        STDOUT_FILENO
                    ) < 0)
                {
                    perror("dup2");
                    exit(EXIT_FAILURE);
                }
            }


            /*
             * Close all pipe descriptors
             * after duplication.
             */

            for (int j = 0;
                 j < command_count - 1;
                 j++)
            {
                close(pipes[j][0]);
                close(pipes[j][1]);
            }


            /*
             * Tokenize command.
             */

            char *args[MAX_ARGS];

            int argc = tokenize(
                commands[i],
                args
            );


            if (argc == 0)
            {
                exit(EXIT_SUCCESS);
            }


            /*
             * Handle redirection.
             */

            handle_redirection(
                args,
                &argc
            );


            /*
             * Execute command.
             */

            execvp(
                args[0],
                args
            );


            perror("execvp");

            exit(EXIT_FAILURE);
        }
    }


    /*
     * Parent closes all pipes.
     */

    for (int i = 0;
         i < command_count - 1;
         i++)
    {
        close(pipes[i][0]);
        close(pipes[i][1]);
    }


    /*
     * Wait for foreground pipeline.
     */

    if (!background)
    {
        for (int i = 0;
             i < command_count;
             i++)
        {
            waitpid(
                pids[i],
                NULL,
                0
            );
        }
    }
    else
    {
        printf(
            "[Background pipeline started]\n"
        );
    }
}


/* ============================================================
   MAIN
   ============================================================ */

int main()
{
    char input[MAX_INPUT];


    /*
     * --------------------------------------------------------
     * SIGNAL SETUP
     * --------------------------------------------------------
     */

    struct sigaction sa;

    memset(
        &sa,
        0,
        sizeof(sa)
    );

    sa.sa_handler = handle_sigchld;

    sigemptyset(
        &sa.sa_mask
    );

    sa.sa_flags =
        SA_RESTART |
        SA_NOCLDSTOP;

    if (sigaction(
            SIGCHLD,
            &sa,
            NULL
        ) < 0)
    {
        perror("sigaction");
        return 1;
    }


    /*
     * Ignore Ctrl+C in shell.
     * Child processes restore default behavior.
     */

    signal(
        SIGINT,
        SIG_IGN
    );


    printf("\n");
    printf("=====================================\n");
    printf("        MINI UNIX SHELL\n");
    printf("=====================================\n");
    printf("Type 'help' for available commands.\n");
    printf("\n");


    /* ========================================================
       MAIN SHELL LOOP
       ======================================================== */

    while (1)
    {
        /*
         * Reap completed background processes.
         */

        if (child_finished)
        {
            reap_background_processes();
        }


        /*
         * Display shell prompt.
         */

        display_prompt();


        /*
         * Read user command.
         */

        if (fgets(
                input,
                sizeof(input),
                stdin
            ) == NULL)
        {
            printf("\n");
            break;
        }


        remove_newline(input);


        /*
         * Ignore empty commands.
         */

        if (strlen(input) == 0)
        {
            continue;
        }


        /*
         * Check background execution.
         *
         * Example:
         *
         * sleep 10 &
         */

        int background = 0;

        size_t len = strlen(input);

        if (len > 0 && input[len - 1] == '&')
        {
            background = 1;

            input[len - 1] = '\0';

            /*
             * Remove trailing spaces.
             */

            while (
                strlen(input) > 0 &&
                input[strlen(input) - 1] == ' '
            )
            {
                input[strlen(input) - 1] = '\0';
            }
        }


        /*
         * Make a copy for pipe processing.
         */

        char pipe_input[MAX_INPUT];

        strcpy(
            pipe_input,
            input
        );


        /*
         * Check whether command contains pipe.
         */

        if (strchr(
                pipe_input,
                '|'
            ) != NULL)
        {
            char *commands[MAX_COMMANDS];


            int command_count =
                split_pipes(
                    pipe_input,
                    commands
                );


            if (command_count > 1)
            {
                execute_pipeline(
                    commands,
                    command_count,
                    background
                );

                continue;
            }
        }


        /*
         * Normal command without pipe.
         */

        char command_copy[MAX_INPUT];

        strcpy(
            command_copy,
            input
        );


        char *args[MAX_ARGS];

        int argc = tokenize(
            command_copy,
            args
        );


        if (argc == 0)
        {
            continue;
        }


        /*
         * Built-in commands execute
         * directly inside parent process.
         */

        if (handle_builtin(
                args,
                argc
            ))
        {
            continue;
        }


        /*
         * Execute external command.
         */

        execute_command(
            args,
            argc,
            background
        );
    }


    return 0;
}
